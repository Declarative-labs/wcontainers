set_so_detach_reuseport_bpf        uapi::SOL_SOCKET uapi::SO_DETACH_REUSEPORT_BPF     c_int                          socket(7)   reads
set_so_max_pacing_rate             uapi::SOL_SOCKET uapi::SO_MAX_PACING_RATE          u64                            socket(7)   reads
set_so_rcvlowat                    uapi::SOL_SOCKET uapi::SO_RCVLOWAT                 c_int                          socket(7)   reads
get_so_rcvlowat                    uapi::SOL_SOCKET uapi::SO_RCVLOWAT                 c_int                          socket(7)   within
set_so_buf_lock                    uapi::SOL_SOCKET uapi::SO_BUF_LOCK                 u32                            socket(7)   reads
