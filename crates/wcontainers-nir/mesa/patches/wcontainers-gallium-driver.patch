diff --git a/src/gallium/drivers/wcontainers/meson.build b/src/gallium/drivers/wcontainers/meson.build
new file mode 100644
index 0000000..1e3c02f
--- /dev/null
+++ b/src/gallium/drivers/wcontainers/meson.build
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: MIT
+# The wcontainers Gallium driver is a static library cargo builds (crates/wcontainers-opengl of
+# wcontainers), linked here with the native libraries rustc printed for it.
+fs = import('fs')
+wcontainers_library = get_option('wcontainers-library')
+if wcontainers_library == ''
+  error('the wcontainers Gallium driver needs -Dwcontainers-library')
+endif
+driver_wcontainers = declare_dependency(
+  compile_args : '-DGALLIUM_WCONTAINERS',
+  link_args : [wcontainers_library] + fs.read(wcontainers_library + '.native-libs').strip().split(),
+)
