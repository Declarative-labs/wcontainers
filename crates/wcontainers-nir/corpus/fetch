#!/usr/bin/env bash
# Fetches the corpus of the NIR route (sources: one pinned commit each) for `cargo test --test corpus`.
#
#   crates/wcontainers-nir/corpus/fetch
#
# Output, kept between runs: $CARGO_TARGET_DIR/nir-corpus/<name> (else target/nir-corpus), the folder
# WC_NIR_CORPUS names. A source already at its pinned commit is not fetched again.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repository=$(cd "$here/../../.." && pwd)
corpus_dir=${CARGO_TARGET_DIR:-$repository/target}/nir-corpus

mkdir -p "$corpus_dir"
grep -v '^#' "$here/sources" | while read -r name url commit paths licence; do
    [ -n "$name" ] || continue
    dir=$corpus_dir/$name
    if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$commit" ]; then
        rm -rf "$dir"
        git init -q "$dir"
        filter=()
        if [ "$paths" != . ]; then
            git -C "$dir" sparse-checkout set --no-cone ${paths//,/ }
            filter=(--filter=blob:none)
        fi
        git -C "$dir" fetch -q --depth 1 "${filter[@]}" "$url" "$commit"
        git -C "$dir" checkout -q FETCH_HEAD
    elif [ "$paths" != . ] && [ "$(git -C "$dir" sparse-checkout list | paste -sd, -)" != "$paths" ]; then
        # The same commit with other paths: the new paths' files are fetched as they are checked out.
        git -C "$dir" sparse-checkout set --no-cone ${paths//,/ }
    fi
    echo "fetch: $name at $commit ($licence)"
done
echo "fetch: done, $corpus_dir"
