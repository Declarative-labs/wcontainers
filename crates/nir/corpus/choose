#!/usr/bin/env bash
# The NIR route's timed corpus run (plan 15.3; route B, the one left since candidate A went with the Mesa compiler
# trait's spirv_common_to_spirv): the corpus through the route and the comparison, optimised, one shader at a time
# on the cores WC_NIR_TIMING_CORES names (a taskset list), so that the times per shader are the route's alone. The
# last lines give the route's counts and its times on the shaders it matches.
#
#   WC_NIR_TIMING_CORES=<cores> crates/nir/corpus/choose [results file]
#
# Needs the pinned Mesa built (mesa/build). WC_NIR_SHADERS and WC_NIR_SEED pick a seeded sample.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repository=$(cd "$here/../../.." && pwd)
target=${CARGO_TARGET_DIR:-$repository/target}
timing_cores=${WC_NIR_TIMING_CORES:?name the cores to time on, as a taskset list}
load() { read -r one five fifteen _ </proc/loadavg; echo "$one $five $fifteen"; }

"$here/fetch"
export WCONTAINERS_MESA=$target/mesa/build
export WC_NIR_CORPUS=$target/nir-corpus
export WC_NIR_RESULTS=${1:-$target/nir-choice.jsonl}
export WC_NIR_JOBS=1
cd "$repository"
cargo test --release -p wcontainers-nir --test corpus --no-run
echo "choose: load $(load) at the start"
taskset -c "$timing_cores" cargo test --release -p wcontainers-nir --test corpus
echo "choose: load $(load) at the end"
