#!/usr/bin/env bash
# Writes the SPIR-V of Godot's RenderingDevice shaders (Forward+, Mobile and their effects) into the
# corpus (test data only, never shipped): each variant `godot-rd-variants` lists, its stages made as
# `ShaderRD` makes them (the corpus binary's `--godot-rd`), compiled by glslang as Godot's
# `compile_glslang_shader` does (Vulkan rules, client Vulkan 1.1, SPIR-V 1.3: what Godot asks of a
# Vulkan 1.1 device).
#
#   crates/nir/corpus/godot-forward-plus [flake]
#
# flake: as mesa/build's (its locked nixpkgs gives glslang). Output:
# $CARGO_TARGET_DIR/nir-corpus/godot-forward-plus (else under target/), made again each time: each
# variant's stage sources and `.spv` files under `<shader file>/`, and `glslang-refused`, one line a
# stage glslang refused, its log beside the source as `<stage>.log`.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repository=$(cd "$here/../../.." && pwd)
corpus_dir=${CARGO_TARGET_DIR:-$repository/target}/nir-corpus
out=$corpus_dir/godot-forward-plus
flake=${1:-$repository}

"$here/fetch"
rm -rf "$out"
mkdir -p "$out"
cargo test -q -p wcontainers-nir --test corpus -- --godot-rd "$corpus_dir/godot" "$out"

jobs=${CARGO_BUILD_JOBS:-$(nproc)}
nix shell --inputs-from "$flake" nixpkgs#glslang -c bash -euo pipefail -c '
    cd "$1"
    find . -name "*.vert" -o -name "*.frag" -o -name "*.comp" | sort |
        xargs -P "$2" -I{} sh -c "glslangValidator -V --target-env vulkan1.1 -o {}.spv {} > {}.log 2>&1 &&
            rm {}.log || { rm -f {}.spv; echo {}; }" > glslang-refused
' compile "$out" "$jobs"
echo "godot-forward-plus: $(find "$out" -name '*.spv' | wc -l) programs," \
    "$(wc -l < "$out/glslang-refused") refused by glslang ($out/glslang-refused)"
