#!/bin/bash
# Sets up the GPU desktop: puts this checkout's desktop scripts in C:\wc\rig, installs the tools
# (desktop/install-tools.ps1) and sets up the job queue (desktop/install-queue.ps1). Each step is
# skipped when already done, so it is safe to run again.
set -euo pipefail
host=tom@192.168.2.183
here=$(cd "$(dirname "$0")" && pwd)
ssh -o BatchMode=yes "$host" "if not exist C:\\wc\\rig mkdir C:\\wc\\rig"
scp -q -o BatchMode=yes "$here"/desktop/* "$host:C:/wc/rig/"
for script in install-tools install-queue; do
    ssh -o BatchMode=yes "$host" powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "C:\\wc\\rig\\$script.ps1" \
        2> >(tr -d '\r' >&2) | tr -d '\r'
    [ "${PIPESTATUS[0]}" = 0 ] || exit 1
done
