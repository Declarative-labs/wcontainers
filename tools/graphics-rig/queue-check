#!/bin/bash
# Checks the GPU queue's rules with jobs that only sleep, on an otherwise idle queue: two jobs
# submitted together run together; with every slot taken, a later job of higher priority starts
# before an earlier one of lower priority; an --alone job starts only when no other job runs, and
# jobs submitted while it runs wait for it. Prints each rule's result; exits 1 if one fails.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
dir=$(mktemp -d "$(git rev-parse --absolute-git-dir)/queue-check.XXXXXX")
trap 'rm -rf "$dir"' EXIT
failed=0

job() { # name, then gpu-job's arguments
    local name=$1
    shift
    "$here/gpu-job" "$@" >"$dir/$name.out" 2>"$dir/$name.err" &
}
seconds() { # name start|end: the desktop's clock time of the job's start or end, in seconds
    local field=2
    [ "$2" = end ] && field=3
    sed -n 's/.*queued \([0-9:.]*\), started \([0-9:.]*\), ended \([0-9:.]*\).*/\1 \2 \3/p' "$dir/$1.err" |
        awk -v f="$field" '{ split($f, t, ":"); print t[1] * 3600 + t[2] * 60 + t[3] }'
}
check() { # description, then an awk condition over the named times a..z given as name=value pairs
    local description=$1 condition=$2
    shift 2
    if awk "$@" "BEGIN { exit !($condition) }"; then echo "pass: $description"; else echo "FAIL: $description"; failed=1; fi
}
sleeper() { echo "ping -n $(($1 + 1)) 127.0.0.1 >nul"; }

slots=$(ssh -o BatchMode=yes tom@192.168.2.183 'C:\wc\bin\pueue.exe -c C:\wc\pueue\pueue.yml status --json' |
    tr -d '\r' | sed -n 's/.*"default":{[^}]*"parallel_tasks":\([0-9]*\).*/\1/p')
echo "the default group runs at most $slots jobs at once"

job a -- "$(sleeper 3)"
job b -- "$(sleeper 3)"
wait
check "two jobs submitted together ran together" 'a0 < b1 && b0 < a1' \
    -v a0="$(seconds a start)" -v a1="$(seconds a end)" -v b0="$(seconds b start)" -v b1="$(seconds b end)"

job short -- "$(sleeper 3)"
for i in $(seq 2 "$slots"); do job "long$i" -- "$(sleeper 8)"; done
sleep 1
job low -- "$(sleeper 1)"
sleep 1
job high --priority 10 -- "$(sleeper 1)"
wait
check "a later job of priority 10 started before an earlier one of priority 0" 'high0 < low0' \
    -v high0="$(seconds high start)" -v low0="$(seconds low start)"

job before1 -- "$(sleeper 4)"
job before2 -- "$(sleeper 4)"
sleep 1
job alone --alone -- "$(sleeper 3)"
sleep 2
job after -- "$(sleeper 1)"
wait
alone_from=$(sed -n 's/^job: alone from \([0-9:.]*\).*/\1/p' "$dir/alone.out" | awk '{ split($1, t, ":"); print t[1] * 3600 + t[2] * 60 + t[3] }')
check "an alone job's command started after the running jobs ended" 'alone0 >= b1 && alone0 >= c1' \
    -v alone0="$alone_from" -v b1="$(seconds before1 end)" -v c1="$(seconds before2 end)"
check "a job submitted during an alone job started after it ended" 'after0 >= alone1' \
    -v after0="$(seconds after start)" -v alone1="$(seconds alone end)"
for f in "$dir"/*.err; do echo "$(basename "$f" .err): $(grep 'gpu-job: task .* queued' "$f" | sed 's/^gpu-job: //')"; done
exit $failed
