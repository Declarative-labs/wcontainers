#!/bin/bash
# Sends this checkout's working tree, committed or not, to the GPU desktop and runs a command there
# (cmd.exe syntax) in that branch's copy, C:\wc\src\<branch>, with cargo building into
# C:\wc\target\<branch>. Output and exit code come back; 125 means the sending failed.
#   tools/graphics-rig/remote cargo build -p wcontainers-graphics-test
set -euo pipefail
[ $# -gt 0 ] || { echo "usage: remote <command>" >&2; exit 2; }
# shellcheck source=tools/graphics-rig/common.sh
. "$(dirname "$0")/common.sh"
root=$(git rev-parse --show-toplevel)
cd "$root"
gitdir=$(git rev-parse --absolute-git-dir)
id=$name.$$
ref=refs/wc-remote/$id
trap 'rm -f "$gitdir/$id".*; git update-ref -d "$ref" 2>/dev/null || true' EXIT

tree=$(working_tree "$gitdir/$id.index")
commit=$(git rev-parse HEAD)
if [ "$tree" != "$(git rev-parse 'HEAD^{tree}')" ]; then
    commit=$(git commit-tree "$tree" -p HEAD -m "working tree of $branch")
fi

cp "$root/tools/graphics-rig/remote.ps1" "$gitdir/$id.ps1"
files=("$gitdir/$id.ps1")
bundle_arg=()
if [ -z "$(git branch -r --contains "$commit" 2>/dev/null)" ]; then
    git update-ref "$ref" "$commit"
    git bundle create -q "$gitdir/$id.bundle" "$ref" --not --remotes=origin
    files+=("$gitdir/$id.bundle")
    bundle_arg=(-Bundle "C:\\wc\\incoming\\$id.bundle")
fi
connect || exit 125
rig_scp "${files[@]}" "$host:C:/wc/incoming/" || exit 125

command=$(printf %s "$*" | base64 | tr -d '\n')
set +e
rig_powershell "C:\\wc\\incoming\\$id.ps1" -Name "$name" -Commit "$commit" ${bundle_arg[@]+"${bundle_arg[@]}"} -Command "$command"
