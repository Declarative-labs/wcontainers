{
  "[rust]": { "editor.defaultFormatter": "verus-lang.verus-analyzer" },
  "verus-analyzer.check.workspace": false,
  "verus-analyzer.check.overrideCommand": ["cargo", "reviewable", "check", "--message-format", "json"],
  "verus-analyzer.rustfmt.overrideCommand": ["cargo", "reviewable", "format"],
  "verus-analyzer.vfs.extraIncludes": ["${workspaceFolder}"],
  // The extension's own run of Verus on save checks one file without cargo, so it cannot find the crates that file imports.
  "verus-analyzer.verus.enable": false,
  // verus-analyzer is this workspace's analyzer, so an installed rust-analyzer does not start here.
  "rust-analyzer.initializeStopped": true,
  "rust-analyzer.statusBar.showStatusBar": "never",
  "cmake.sourceDirectory": "${workspaceFolder}/crates/shaders/dxil-spirv",
  // Restarts the other extensions once the Nix shell's environment from `.envrc` is loaded, so the analyzer runs in it.
  "direnv.restart.automatic": true
}
