{
  // TEMPORARY (2026-11-22): the full `cargo reviewable check` on every save is too slow until it is incremental.
  // Until then a save checks only the crate being edited with plain cargo. To put the linter back, delete the
  // next line and uncomment the one after it.
  "rust-analyzer.check.workspace": false,
  // "rust-analyzer.check.overrideCommand": ["cargo", "reviewable", "check", "--message-format", "json"],
  "rust-analyzer.vfs.extraIncludes": [
    "${workspaceFolder}"
  ],
  "cmake.sourceDirectory": "/Users/thomaseaton/Documents/GitHub/wcontainers/crates/shaders/dxil-spirv",
  "rust-analyzer.rustfmt.overrideCommand": ["cargo", "reviewable", "format"],
  "rust-analyzer.check.overrideCommand": ["cargo", "reviewable", "check", "--message-format", "json"],
  // The Rust tools must run with the Nix shell's environment that `.envrc` loads. The direnv extension loads it, but
  // by default it only offers to restart the other extensions; without that restart rust-analyzer keeps the old
  // environment, one dependency's build script fails, and every check takes seconds longer.
  "direnv.restart.automatic": true
}
